# @bridgenode/mcp — .env template (§8.4)
# Key: Solana wallet private key (base58) — agent's payment wallet
BRIDGENODE_WALLET_KEY=

# Spending policy (§8.4, fail-closed)
BRIDGENODE_MAX_PER_CALL=0.05
BRIDGENODE_DAILY_CAP=1.0

# (Optional) Remote MCP URL — defaults to https://bridgenode.cc/mcp
# BRIDGENODE_MCP_URL=https://bridgenode.cc/mcp
