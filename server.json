{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.applefanaimail-blip/bridgenode-mcp",
  "title": "BridgeNode MCP",
  "description": "AI inference via MCP — pay per request with Solana USDC through x402. No API keys.",
  "version": "1.0.7",
  "websiteUrl": "https://bridgenode.cc",
  "icons": [
    {
      "src": "https://bridgenode.cc/logos/bridgenode.jpg",
      "mimeType": "image/jpeg",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://bridgenode.cc/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@bridgenode/mcp",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "repository": {
    "source": "github",
    "url": "https://github.com/applefanaimail-blip/bridgenode-mcp"
  }
}